#!/usr/bin/env bash
# Tiny CLI for MirrorUE local automation API (default http://127.0.0.1:8090).
set -euo pipefail
BASE="${MIRRORUE_API:-http://127.0.0.1:8090}"

usage() {
  cat <<EOF
Usage: $(basename "$0") <command> [args]

  status
  tap <x> <y>                 # normalized 0..1
  swipe <x> <y> <x1> <y1> [ms]
  type <text>
  key <usage> [mods]
  button <name>               # home|lock|mute|…
  run <workflow.json>

Env: MIRRORUE_API=$BASE
EOF
}

cmd="${1:-}"
shift || true
case "$cmd" in
  status|"")
    curl -sS "$BASE/v1/status" | python3 -m json.tool 2>/dev/null || curl -sS "$BASE/v1/status"
    echo
    ;;
  tap)
    curl -sS -X POST "$BASE/v1/tap" -H 'Content-Type: application/json' \
      -d "{\"x\":${1:?},\"y\":${2:?}}"
    echo
    ;;
  swipe)
    curl -sS -X POST "$BASE/v1/swipe" -H 'Content-Type: application/json' \
      -d "{\"x\":${1:?},\"y\":${2:?},\"x1\":${3:?},\"y1\":${4:?},\"ms\":${5:-300}}"
    echo
    ;;
  type)
    python3 - <<PY
import json,urllib.request
body=json.dumps({"text":"""${*:?}"""}).encode()
r=urllib.request.Request("$BASE/v1/type",data=body,headers={"Content-Type":"application/json"},method="POST")
print(urllib.request.urlopen(r).read().decode())
PY
    ;;
  key)
    curl -sS -X POST "$BASE/v1/key" -H 'Content-Type: application/json' \
      -d "{\"usage\":${1:?},\"mods\":${2:-0}}"
    echo
    ;;
  button)
    curl -sS -X POST "$BASE/v1/button" -H 'Content-Type: application/json' \
      -d "{\"name\":\"${1:?}\"}"
    echo
    ;;
  run)
    curl -sS -X POST "$BASE/v1/workflows/run" -H 'Content-Type: application/json' \
      --data-binary @"${1:?}"
    echo
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac
