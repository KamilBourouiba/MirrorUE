def cmd_agent(ns: argparse.Namespace) -> int:
    goal = " ".join(ns.goal).strip()
    if not goal:
        raise SystemExit("goal required")
    wait_ready(ns.wait_timeout)
    started = api(
        "POST",
        "/v1/agent/run",
        {"goal": goal, "maxSteps": int(ns.max_steps)},
        timeout=10,
    )
    if ns.no_wait:
        out(started)
        return 0

    run_id = started.get("runId") if isinstance(started, dict) else None
    if not isinstance(run_id, str) or not run_id:
        raise SystemExit("agent run was accepted without a runId")
    try:
        uuid.UUID(run_id)
    except ValueError:
        raise SystemExit(f"agent returned an invalid runId: {run_id!r}") from None

    deadline = time.time() + float(ns.timeout)
    last: dict[str, Any] = started if isinstance(started, dict) else {}
    try:
        while time.time() < deadline:
            last = api("GET", "/v1/agent/status", timeout=5)
            observed_id = last.get("runId") if isinstance(last, dict) else None
            if observed_id != run_id:
                raise SystemExit(
                    f"agent status switched from run {run_id} to "
                    f"{observed_id or 'no run'}; refusing to follow another run"
                )
            if not last.get("running") and last.get("state") not in {"queued", "starting"}:
                out(last)
                return 0 if last.get("ok", True) and last.get("state") == "completed" else 1
            time.sleep(0.35)
    except KeyboardInterrupt:
        api("POST", "/v1/agent/stop", {"runId": run_id}, timeout=5)
        raise SystemExit("agent stopped") from None

    last_state = last.get("state", "unknown")
    try:
        stopped = api(
            "POST",
            "/v1/agent/stop",
            {"runId": run_id},
            timeout=5,
        )
        stop_state = stopped.get("state", "unknown") if isinstance(stopped, dict) else "unknown"
    except SystemExit as stop_error:
        raise SystemExit(
            f"agent did not finish within {float(ns.timeout):.0f}s "
            f"(last state: {last_state}); cancellation for run {run_id} failed: {stop_error}"
        ) from None
    raise SystemExit(
        f"agent did not finish within {float(ns.timeout):.0f}s "
        f"(last state: {last_state}); cancellation requested for run {run_id} "
        f"(stop state: {stop_state})"
    )


