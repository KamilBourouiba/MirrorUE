def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="mirrorue",
        description="Control MirrorUE from the terminal (local API).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    p.add_argument("--api", default=BASE, help="API base URL (env MIRRORUE_API)")
    sub = p.add_subparsers(dest="cmd", required=True)

    st = sub.add_parser("status", help="Connection / FPS")
    st.add_argument("--wait", action="store_true", help="Wait until connected + live display")
    st.add_argument("--wait-timeout", type=float, default=60)
    st.set_defaults(func=cmd_status)
    sub.add_parser("help-api", help="List HTTP endpoints").set_defaults(func=cmd_help)
    sub.add_parser("home", help="Go to Home Screen (gesture)").set_defaults(func=cmd_home)

    w = sub.add_parser("wait", help="Sleep on device side")
    g = w.add_mutually_exclusive_group()
    g.add_argument("seconds", nargs="?", type=float, default=0.5)
    g.add_argument("--ms", type=int, default=None)
    w.set_defaults(func=cmd_wait)

    sp = sub.add_parser("spotlight", help="Open Spotlight search")
    sp.add_argument("--no-home", action="store_true", help="Skip Home first")
    sp.set_defaults(func=cmd_spotlight)

    cl = sub.add_parser("clear", help="Clear focused text field")
    cl.add_argument("--backspaces", type=int, default=12)
    cl.set_defaults(func=cmd_clear)

    op = sub.add_parser("open", help="Open an app via Search (deterministic)")
    op.add_argument("app", nargs="+", help="App name, e.g. Snapchat")
    op.add_argument("--wait-timeout", type=float, default=45)
    op.set_defaults(func=cmd_open)

    tp = sub.add_parser("tap", help="Tap normalized 0..1")
    tp.add_argument("x", type=float)
    tp.add_argument("y", type=float)
    tp.set_defaults(func=cmd_tap)

    sw = sub.add_parser("swipe", help="Swipe normalized 0..1")
    sw.add_argument("x", type=float)
    sw.add_argument("y", type=float)
    sw.add_argument("x1", type=float)
    sw.add_argument("y1", type=float)
    sw.add_argument("ms", nargs="?", type=int, default=300)
    sw.set_defaults(func=cmd_swipe)

    ty = sub.add_parser("type", help="Type text via HID keyboard")
    ty.add_argument("text", nargs="+")
    ty.set_defaults(func=cmd_type)

    ky = sub.add_parser("key", help="HID key usage")
    ky.add_argument("usage", type=int)
    ky.add_argument("mods", nargs="?", type=int, default=0)
    ky.set_defaults(func=cmd_key)

    bt = sub.add_parser("button", help="Hardware button name")
    bt.add_argument("name")
    bt.set_defaults(func=cmd_button)

    fr = sub.add_parser("frame", help="Save latest phone frame")
    fr.add_argument("out", nargs="?", default=None, help="Destination path")
    fr.add_argument("--max-w", type=int, default=720)
    fr.add_argument("--format", default="jpg", choices=["jpg", "png"])
    fr.add_argument("--json", action="store_true")
    fr.add_argument("--b64", action="store_true", help="Request base64 encoding (faster for agents)")
    fr.set_defaults(func=cmd_frame)

    ls = sub.add_parser("llm-status", help="Check the configured model provider")
    ls.set_defaults(func=cmd_llm_status)

    lc = sub.add_parser("llm-chat", help="Send a text-only provider test")
    lc.add_argument("prompt", nargs="+")
    lc.add_argument("--model", default=None)
    lc.add_argument("--max-tokens", type=int, default=128)
    lc.add_argument("--timeout", type=float, default=120)
    lc.set_defaults(func=cmd_llm_chat)

    ag = sub.add_parser("agent", help="Run an AI goal against the connected iPhone")
    ag.add_argument("goal", nargs="+")
    ag.add_argument("--max-steps", type=int, default=12)
    ag.add_argument("--timeout", type=float, default=180)
    ag.add_argument("--wait-timeout", type=float, default=45)
    ag.add_argument("--no-wait", action="store_true", help="Return after the run is accepted")
    ag.set_defaults(func=cmd_agent)
    sub.add_parser("agent-status", help="Show current AI run").set_defaults(func=cmd_agent_status)
    sub.add_parser("agent-logs", help="Show current AI trace").set_defaults(func=cmd_agent_logs)
    sub.add_parser("agent-stop", help="Cancel current AI run").set_defaults(func=cmd_agent_stop)

    sub.add_parser("docs-api", help="Print full API documentation").set_defaults(func=cmd_docs)

    do = sub.add_parser("do", help="Run short recipe tokens")
    do.add_argument(
        "steps",
        nargs="+",
        help="Tokens: home wait:0.8 open:Snapchat type:hi tap:0.5,0.8",
    )
    do.set_defaults(func=cmd_do)

    workflow = sub.add_parser(
        "workflow",
        aliases=["path"],
        help="Record, save, replay and export deterministic workflows",
    )
    workflow_sub = workflow.add_subparsers(dest="workflow_cmd", required=True)
    workflow_sub.add_parser(
        "list",
        help="List saved workflows",
    ).set_defaults(func=cmd_workflow_list)
    workflow_sub.add_parser(
        "status",
        help="Show recording/playback state",
    ).set_defaults(func=cmd_workflow_status)

    record = workflow_sub.add_parser("record", help="Record manual phone input")
    record_sub = record.add_subparsers(dest="record_cmd", required=True)
    record_sub.add_parser(
        "start",
        help="Start recording",
    ).set_defaults(func=cmd_workflow_record_start)
    record_stop = record_sub.add_parser("stop", help="Stop recording")
    record_stop.add_argument("--name", "-n", help="Save immediately under this name")
    record_stop.set_defaults(func=cmd_workflow_record_stop)

    workflow_save = workflow_sub.add_parser("save", help="Save current recorded steps")
    workflow_save.add_argument("name")
    workflow_save.set_defaults(func=cmd_workflow_save)

    workflow_play = workflow_sub.add_parser("play", help="Replay a saved workflow")
    workflow_play.add_argument("name")
    workflow_play.add_argument("--timeout", type=float, default=600)
    workflow_play.set_defaults(func=cmd_workflow_play)

    workflow_sub.add_parser(
        "stop",
        help="Stop workflow playback",
    ).set_defaults(func=cmd_workflow_stop)

    workflow_export = workflow_sub.add_parser("export", help="Export workflow JSON")
    workflow_export.add_argument("name")
    workflow_export.add_argument("destination")
    workflow_export.set_defaults(func=cmd_workflow_export)

    return p


def main(argv: list[str] | None = None) -> int:
    global BASE
    argv = list(sys.argv[1:] if argv is None else argv)
    # Friendly default when invoked with no args
    if not argv:
        argv = ["status"]
    p = build_parser()
    ns = p.parse_args(argv)
    BASE = (ns.api or BASE).rstrip("/")
    return int(ns.func(ns) or 0)


if __name__ == "__main__":
    raise SystemExit(main())
